venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.vscode/
.idea/
.DS_Store

# Fortran build artifacts. gfortran writes a .mod into the CURRENT WORKING
# DIRECTORY for every `module` it compiles — including under
# `gfortran -fsyntax-only`, which is how 32 of them from numpy's f2py test
# corpus ended up committed at the repo root. They are regenerated by every
# build and belong to no source tree.
*.mod
*.smod
*.o

# Compiled extension modules. `ngate build` installs the pybind11/f2py module
# into services/<name>/python/<pkg>/, i.e. next to tracked sources rather than
# under dist/ — so the dist/ and build/ rules above do not catch them. No .so
# is ever a source file in this repo; if one ever needs committing, force it
# with `git add -f`.
*.so
*.dylib
*.pyd
*.whl

# scikit-build-core / f2py scratch. _skbuild/ is scikit-build's staging tree
# and .f2py_f2cmap is written into the working directory by f2py itself.
_skbuild/
wheelhouse/
.f2py_f2cmap

# mkdocs output (`mkdocs build`). Already ignored under tools/nativegate/;
# repeated here so a build run from the repo root is also covered.
site/

# Test/coverage output.
.coverage
.coverage.*
htmlcov/
coverage.xml
