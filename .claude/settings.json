{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-code-review.sh\"",
            "timeout": 15,
            "statusMessage": "Checking code-review approval"
          }
        ]
      }
    ]
  }
}
