# Generated by native2py. Do not edit by hand — re-run `native2py docker petro_api`.
# Build from services/petro_api/:
#   docker build -t petro_api:latest .
# Base image is DIGEST-PINNED, not tag-pinned — see docker_gen.BASE_IMAGE_DIGEST
# for why, and for how to refresh it.
FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a AS builder

RUN apt-get update && \
    apt-get install -y \
        build-essential=12.12 \
        gcc-14=14.2.0-19 \
        g++-14=14.2.0-19 \
        gfortran=4:14.2.0-1 \
        gfortran-14=14.2.0-19 \
        cmake=3.31.6-2 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY . .

RUN pip install --no-cache-dir build scikit-build-core numpy meson ninja

RUN pip wheel . -w /dist --no-build-isolation



FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgfortran5=14.2.0-19 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /dist /dist

COPY requirements.lock ./requirements.lock

# --require-hashes: every dependency pinned by version AND sha256, so a
# rebuild either installs exactly this or fails. Generated by `native2py lock`.
RUN pip install --no-cache-dir --require-hashes -r requirements.lock

RUN pip install --no-cache-dir --no-deps /dist/*.whl

# design.md section 21: run as non-root. UID is explicit so a Kubernetes
# `runAsUser: 1000` and `runAsNonRoot: true` match the image rather than
# fighting it.
RUN useradd --create-home --uid 1000 appuser
USER appuser

# The generated Kubernetes manifests set readOnlyRootFilesystem: true. Python
# writing .pyc files next to the source would fail against that, so the
# interpreter is told not to. PYTHONUNBUFFERED so logs reach the collector as
# they happen rather than when a buffer fills — a service that crashes with
# its last log lines still buffered is one you cannot debug.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/docs')" || exit 1

# Crash containment: gunicorn supervises the workers, so a segfault or
# Fortran STOP in native code kills one worker instead of the service,
# and --timeout reaps one that hangs. See docker_gen for the full note.
# One worker: COMMON blocks are per-process, so a configure call and
# the compute that reads it must reach the SAME process. Raise this
# only for routines that keep no state between calls.
ENV WEB_CONCURRENCY=1

CMD ["gunicorn", "petro_api.service:app", \
     "--worker-class", "uvicorn_worker.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "60", \
     "--graceful-timeout", "30", \
     "--max-requests", "1000", \
     "--max-requests-jitter", "100"]
